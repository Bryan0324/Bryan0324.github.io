---
import type { MarkdownHeading } from 'astro';
import { site, theme } from '../lib/config.mjs';
import { themeStyle } from '../lib/theme-style.mjs';
import { localDate } from '../lib/urls.mjs';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import 'star-markdown-css/dist/yun/yun-markdown.min.css';
import 'katex/dist/katex.min.css';
import '../styles/yun.css';
import '../styles/astro.css';
interface Props { title?: string; description?: string | null; home?: boolean; headings?: MarkdownHeading[]; image?: string; }
const { title, description, home, headings } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html\/$/, '.html'), site.url);
---
<!doctype html>
<html lang={site.language || 'zh-TW'} class={theme.mode === 'dark' ? 'dark' : theme.mode === 'sunset' ? 'sunset' : ''} data-mode={theme.mode} style={themeStyle(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.author} />
    <meta name="description" content={description || site.description || site.subtitle} />
    <meta name="theme-color" content={theme.colors.primary} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || site.description || site.subtitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={theme.favicon || '/grass_cat.png'} />
    {theme.font.cdn.enable && theme.font.cdn.lib.map((url: string) => <link rel="stylesheet" href={url} />)}
    <script is:inline>
      (() => {
        let mode = document.documentElement.dataset.mode;
        try { mode = localStorage.getItem('darken-mode') || mode; } catch {}
        if (mode === 'auto') mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (mode === 'time') { const h = new Date().getHours(); mode = h >= 20 || h < 7 ? 'dark' : h >= 17 ? 'sunset' : 'light'; }
        document.documentElement.classList.remove('dark', 'sunset');
        if (mode === 'dark' || mode === 'sunset') document.documentElement.classList.add(mode);
      })();
    </script>
  </head>
  <body class:list={{ 'is-home': home }} data-fireworks={theme.fireworks.enable ? JSON.stringify(theme.fireworks.colors) : undefined} data-mermaid={String(theme.mermaid.enable)} data-reveal={String(theme.scrollreveal.enable)}>
    <a class="skip-link" href="#content">跳至主要內容</a>
    {theme.fireworks.enable && <canvas class="fireworks" aria-hidden="true"></canvas>}
    <div class="container">
      <Sidebar headings={headings} />
      <main id="content" class="sidebar-translate"><slot /></main>
      <footer id="footer" class="sidebar-translate">
        <div class="copyright"><span>© {theme.footer.since} – {new Date().getFullYear()}</span><span id="animate" class="with-love"><Icon name={theme.footer.icon.name} /></span><span class="author">{site.author}</span></div>
        {theme.footer.powered.enable && <div class="powered">由 <a href="https://astro.build/">Astro</a> 驅動<span class="footer-separator">|</span>主題 - <a href="https://github.com/YunYouJun/hexo-theme-yun">Yun</a>（Astro 移植）</div>}
        {theme.footer.live_time.enable && <div class="live-time">{theme.footer.live_time.prefix} <span id="live-time" data-start={localDate(theme.footer.live_time.start_time, site.timezone).toISOString()}></span><span class="moe-text">{theme.footer.live_time.suffix}</span></div>}
      </footer>
    </div>
    <a id="back-to-top" class="hty-icon-button" href="#content" aria-label="回到頂部"><Icon name="ri:arrow-up-s-line" /><svg class="progress-circle-container" viewBox="0 0 100 100" aria-hidden="true"><circle id="progressCircle" class="progress-circle" cx="50" cy="50" r="48" fill="none" stroke={theme.colors.primary} stroke-width="2" stroke-linecap="round" /></svg></a>
    {theme.local_search.enable && <>
    <button id="search" class="hty-icon-button icon-search" data-search-open aria-label="搜尋文章"><span class="site-state-item-icon"><Icon name="ri:search-line" /></span></button>
    <dialog id="search-dialog" class="popup search-popup" aria-labelledby="search-title">
      <h2 id="search-title" class="sr-only">搜尋文章</h2>
      <div class="search-header"><button class="popup-btn-close close-icon hty-icon-button" data-search-close aria-label="關閉搜尋"><Icon name="ri:close-line" /></button></div>
      <label class="sr-only" for="search-input">搜尋關鍵字</label>
      <div class="search-input-container"><input id="search-input" class="search-input" type="search" placeholder={theme.search.placeholder} autocomplete="off" /></div>
      <div class="search-result-container"><p id="search-status" role="status"></p><ul id="search-results" class="search-result-list"></ul></div>
    </dialog></>}
    <script src="../scripts/client.ts"></script>
  </body>
</html>
