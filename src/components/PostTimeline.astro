---
import { formatDate, postUrl, type Post } from '../lib/content';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="post-collapse">{posts.map((post, index) => {
  const date = formatDate(post.data.date!);
  const year = date.slice(0, 4);
  const startsYear = index === 0 || formatDate(posts[index - 1].data.date!).slice(0, 4) !== year;
  return <>
    {startsYear && <div class="collection-title"><h2 class="archive-year" id={`archive-year-${year}`}>{year}</h2></div>}
    <article class="post-item"><header class="post-header">
      <div class="post-meta"><time class="post-time" datetime={date}>{date.slice(5)}</time></div>
      <h2 class="post-title"><a class="post-title-link" href={postUrl(post)}>{post.data.title}</a></h2>
    </header></article>
  </>;
})}</div>
