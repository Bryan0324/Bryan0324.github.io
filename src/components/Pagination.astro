---
import { href } from '../lib/urls.mjs';
import Icon from './Icon.astro';
interface Props { page: number; total: number; base: string; }
const { page, total, base } = Astro.props;
const url = (n: number) => href(n === 1 ? base : `${base ? base + '/' : ''}page/${n}`);
---
{total > 1 && <nav class="pagination" aria-label="分頁">
  {page > 1 && <a class="extend prev" href={url(page - 1)} rel="prev" aria-label="上一頁"><Icon name="ri:arrow-left-s-line" /></a>}
  {Array.from({ length: total }, (_, i) => i + 1).map((n) => n === page
    ? <span class="page-number current" aria-current="page">{n}</span>
    : <a class="page-number" href={url(n)}>{n}</a>)}
  {page < total && <a class="extend next" href={url(page + 1)} rel="next" aria-label="下一頁"><Icon name="ri:arrow-right-s-line" /></a>}
</nav>}
