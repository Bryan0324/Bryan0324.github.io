---
import { postUrl, type Post } from '../lib/content';
import { theme } from '../lib/config.mjs';
import PostMeta from './PostMeta.astro';
import Icon from './Icon.astro';
import TaxonomyLinks from './TaxonomyLinks.astro';
interface Props { post: Post; }
const { post } = Astro.props;
const external = post.data.type && post.data.url;
const excerpt = post.rendered?.html?.split(/<!--\s*more\s*-->/i);
const hasExcerpt = excerpt && excerpt.length > 1;
---
<article class="post-card">
  {(post.data.top || post.data.sticky) && <span class="post-top-icon" title="置頂"><Icon name="ri:pushpin-line" /></span>}
  <div class="post-card-header"><header class="post-header">
    <h2 class="post-title"><a class="post-title-link" href={external || postUrl(post)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{post.data.title}</a></h2>
    <PostMeta entry={post} />
    {post.data.description && <div class="post-description">{post.data.description}</div>}
  </header></div>
  <div class="post-card-content text-center">
    <div class="post-card-excerpt markdown-body" set:html={hasExcerpt ? excerpt[0] : ''} />
    {hasExcerpt && <a class="hty-button hty-button--raised" style={`margin:1rem;background-color:${theme.colors.primary}`} href={postUrl(post)}>閱讀更多</a>}
  </div>
  <div class="hty-card__actions post-card__actions">
    <div class="post-card-category">{theme.post_meta.categories && post.data.categories.length ? <TaxonomyLinks kind="categories" names={post.data.categories} /> : <Icon name="ri:folder-line" />}</div>
    <div class="post-card-tag">{theme.post_meta.tags && post.data.tags.length ? <TaxonomyLinks kind="tags" names={post.data.tags} /> : <Icon name={theme.icons.tag} />}</div>
  </div>
</article>
